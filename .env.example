# .env.example. 
# It is a template for a local .env, with secrets left blank. 
# Real .env files are in .gitignore and .dockerignore. 
# It also documents the optional settings (drift, alerts, labeller, model source).


# Copy to .env for local runs. Never commit .env, it is in .gitignore.
# On Render, set these as environment variables / secrets in the service settings instead.

# Logging
LOG_LEVEL=INFO
LIB_LOG_LEVEL=INFO
# LOG_DIR=logs

# Drift detection
# DRIFT_REFERENCE=data/reference/reference.json
# DRIFT_WINDOW_SIZE=200
# DRIFT_MIN_WINDOW=100
# DRIFT_PSI_THRESHOLD=0.25

# Alert emails (Gmail: turn on 2-step verification, then create an app password)
SMTP_USER=
SMTP_PASSWORD=
ALERT_TO=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# ALERT_FROM=
# ALERT_COOLDOWN_SECONDS=3600

# Saving requests and labelling them (src/feedback_store.py, src/labeler.py)
# FEEDBACK_STORE=off          # stops saving requests
DATABASE_URL=
# GROQ_API_KEY is a secret: set it in your shell or on the host, not in a file you commit
GROQ_API_KEY=
# LABEL_MODEL=openai/gpt-oss-20b
# LABEL_DAILY_CAP=200
# LABEL_MIN_INTERVAL_SECONDS=6
# LABEL_POLL_SECONDS=360
# LABEL_ENABLED=true

# Model weights fetched at build or start (scripts/fetch_model.py)
# MODEL_HF_REPO=Musknnnn/nlptown-sentiment
