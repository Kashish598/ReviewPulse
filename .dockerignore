# Keep the build context small and keep secrets and local state out of the image.
.git
.github
.gitignore
.venv
venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache

# Local state
.env
.env.*
*.db
*.sqlite
mlruns
mlartifacts
logs

# Not needed to serve predictions
tests
docs
notebooks
models
data/*
!data/reference
*.zip
